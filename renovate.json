{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions pinned in versions.env",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "A generator bump changes every SDK; never automerge it",
      "matchDepNames": ["openapitools/openapi-generator-cli"],
      "automerge": false,
      "labels": ["dependencies", "regenerates-sdks"]
    },
    {
      "description": "google-java-format needs its checksum updated by hand too",
      "matchDepNames": ["google/google-java-format"],
      "prBodyNotes": ["Update GOOGLE_JAVA_FORMAT_SHA256 in versions.env to the -all-deps.jar digest from the release page."]
    }
  ]
}
