# Pinned tool versions. Renovate keeps these current (see renovate.json);
# a bump here regenerates every SDK, so review the resulting SDK PRs carefully.

# renovate: datasource=docker depName=openapitools/openapi-generator-cli
OPENAPI_GENERATOR_VERSION=v7.27.0
# renovate: datasource=npm depName=openapi-format
OPENAPI_FORMAT_VERSION=1.34.0
# renovate: datasource=github-releases depName=google/google-java-format
GOOGLE_JAVA_FORMAT_VERSION=2.0.0
GOOGLE_JAVA_FORMAT_SHA256=c78feb48c549fa7114b7ea11db3b456808f7b371ffe84e6643a44dd2f9588639
# renovate: datasource=npm depName=prettier
PRETTIER_VERSION=3.10.1
# renovate: datasource=pypi depName=ruff
RUFF_VERSION=0.17.5
# renovate: datasource=docker depName=tufin/oasdiff
OASDIFF_VERSION=v1.37.0
# renovate: datasource=go depName=github.com/oapi-codegen/oapi-codegen/v2
OAPI_CODEGEN_VERSION=v2.8.2
